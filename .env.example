# Copy this file to .env (same folder) and fill in ANTHROPIC_API_KEY. .env is git-ignored.
# Never commit real keys. See docs/RUN-LOCALLY.md for how to get each key.

# REQUIRED: your Anthropic API key (starts with sk-ant-). The agent can't answer without it.
ANTHROPIC_API_KEY=

# Local database passwords. The database only listens on 127.0.0.1 on your own machine, so
# these defaults are fine for a local run. If you change them after the first start, run
# `docker compose down -v` once so the database is re-created with the new passwords.
ETRM_OWNER_PASSWORD=local-owner-change-me
ETRM_APP_PASSWORD=local-app-change-me
ETRM_INGEST_PASSWORD=local-ingest-change-me

# Ports on your machine. Change them only if something else already uses them.
ETRM_DB_HOST=127.0.0.1
ETRM_DB_PORT=5433
ETRM_API_PORT=8000
ETRM_UI_PORT=8501

# OPTIONAL: Langfuse Cloud tracing. Leave empty to skip; traces are still written locally to .traces/.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
